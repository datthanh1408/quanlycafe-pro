@model MenuFilterVm
@{
    ViewData["Title"] = "Thực đơn";
    var baseQuery = $"/menu?keyword={Uri.EscapeDataString(Model.Keyword ?? "")}&categoryId={Model.CategoryId}&minPrice={Model.MinPrice}&maxPrice={Model.MaxPrice}&onlyAvailable={Model.OnlyAvailable.ToString().ToLower()}&sort={Model.Sort}";
}

<div class="container py-4 py-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
        <div>
            <span class="text-accent fw-bold small text-uppercase">Thưởng thức trọn vị</span>
            <h1 class="h2 fw-bold font-display mb-0">Thực đơn Đạt Mộc Coffee</h1>
        </div>
        <span class="text-muted small">Hiển thị <strong>@Model.Products.TotalItems</strong> món</span>
    </div>

    <!-- Chip Danh mục nhanh -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/menu?keyword=@Model.Keyword&onlyAvailable=@Model.OnlyAvailable.ToString().ToLower()&sort=@Model.Sort"
           class="btn btn-sm rounded-pill px-3 @(Model.CategoryId == null ? "btn-coffee" : "btn-outline-coffee")">
            Tất cả món
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a href="/menu?categoryId=@cat.Id&keyword=@Model.Keyword&onlyAvailable=@Model.OnlyAvailable.ToString().ToLower()&sort=@Model.Sort"
               class="btn btn-sm rounded-pill px-3 @(Model.CategoryId == cat.Id ? "btn-coffee" : "btn-outline-coffee")">
                <i class="bi @cat.IconClass me-1"></i> @cat.Name
            </a>
        }
    </div>

    <!-- Bộ lọc tìm kiếm (có debounce), khoảng giá, trạng thái còn hàng, sắp xếp (Mục 7.1) -->
    <form method="get" action="/menu" id="menuFilterForm" class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        @if (Model.CategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
        }
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" id="menuSearchInput" value="@Model.Keyword" class="form-control border-start-0" placeholder="Tìm cà phê, trà đào, croissant..." />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control" placeholder="Giá từ (₫)" min="0" step="5000" />
            </div>
            <div class="col-6 col-md-2">
                <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control" placeholder="Đến (₫)" min="0" step="5000" />
            </div>
            <div class="col-6 col-md-2">
                <select name="sort" class="form-select" onchange="this.form.submit()">
                    <option value="popular" selected="@(Model.Sort == "popular")">Phổ biến nhất</option>
                    <option value="newest" selected="@(Model.Sort == "newest")">Mới nhất</option>
                    <option value="price_asc" selected="@(Model.Sort == "price_asc")">Giá tăng dần</option>
                    <option value="price_desc" selected="@(Model.Sort == "price_desc")">Giá giảm dần</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex align-items-center justify-content-between gap-2">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="onlyAvailable" value="true" id="chkAvail" checked="@Model.OnlyAvailable" onchange="this.form.submit()" />
                    <label class="form-check-label small" for="chkAvail">Còn hàng</label>
                </div>
                <button type="submit" class="btn btn-coffee btn-sm px-3">Lọc</button>
            </div>
        </div>
    </form>

    <!-- Lưới Sản phẩm / Empty State -->
    @if (Model.Products.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-cup-straw display-4 text-muted mb-3"></i>
            <h2 class="h5 fw-bold">Không tìm thấy món phù hợp</h2>
            <p class="text-muted small mb-3">Hãy thử bỏ bớt điều kiện lọc hoặc tìm với từ khóa khác.</p>
            <div>
                <a href="/menu" class="btn btn-outline-coffee px-4">Xem lại toàn bộ thực đơn</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model.Products.Items)
            {
                <div class="col-sm-6 col-lg-4">
                    <partial name="_ProductCardPartial" model="p" />
                </div>
            }
        </div>

        <partial name="_Pagination" model="(Model.Products.Page, Model.Products.TotalPages, baseQuery)" />
    }
</div>

@section Scripts {
    <script>
        (function () {
            let timer = null;
            const inp = document.getElementById('menuSearchInput');
            const form = document.getElementById('menuFilterForm');
            inp?.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => form?.submit(), 480);
            });
        })();
    </script>
}

