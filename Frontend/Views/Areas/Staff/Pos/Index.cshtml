@model StaffPosVm
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Máy bán hàng POS tại quầy";
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
    var defaultPaymentCode = Model.PaymentMethods.FirstOrDefault()?.Code ?? "CASH";
}

<div class="row g-3">
    <!-- Cột trái: Danh mục + Tìm kiếm + Lưới món chạm nhanh (>= 48px) -->
    <div class="col-lg-7 col-xl-8">
        <div class="card card-coffee h-100">
            <div class="card-header bg-white border-bottom py-2">
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-6">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-calculator-fill text-coffee me-2"></i>Thực đơn POS tại quầy
                        </h5>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-cream border-end-0"><i class="bi bi-search"></i></span>
                            <input type="search" id="posSearchInput" class="form-control border-start-0"
                                   placeholder="Tìm nhanh tên món (Cà phê sữa, Trà đào, Croissant...)" />
                        </div>
                    </div>
                </div>

                <!-- Tab danh mục chạm nhanh -->
                <div class="d-flex flex-wrap gap-2 pt-1">
                    <button type="button" class="btn btn-coffee staff-touch-btn btn-sm px-3" data-pos-cat="ALL">
                        <i class="bi bi-stars me-1"></i>Tất cả món
                    </button>
                    @foreach (var cat in Model.Categories)
                    {
                        <button type="button" class="btn btn-outline-coffee staff-touch-btn btn-sm px-3" data-pos-cat="@cat.Id">
                            @cat.Name
                        </button>
                    }
                </div>
            </div>

            <div class="card-body p-3" style="max-height: calc(100vh - 210px); overflow-y: auto;">
                <div class="row g-2" id="posProductGrid"></div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Phiếu gọi món & Thanh toán tại quầy -->
    <div class="col-lg-5 col-xl-4">
        <div class="card card-coffee shadow-sm">
            <div class="card-header bg-coffee text-white py-2 d-flex align-items-center justify-content-between">
                <span class="fw-bold"><i class="bi bi-receipt me-2"></i>Phiếu bán hàng POS</span>
                <button type="button" id="posClearCartBtn" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-trash3 me-1"></i>Làm mới
                </button>
            </div>

            <div class="card-body p-3 d-flex flex-column gap-2">
                <!-- Hình thức phục vụ & Chọn bàn (hỗ trợ cả Dropdown và Sơ đồ 3D) -->
                <div class="row g-2">
                    <div class="col-5">
                        <label class="form-label small fw-bold mb-1">Hình thức</label>
                        <select id="posOrderType" class="form-select">
                            <option value="0" selected>Tại quán</option>
                            <option value="1">Mang đi</option>
                        </select>
                    </div>
                    <div class="col-7" id="posTableSelectWrap">
                        <label class="form-label small fw-bold mb-1 d-flex justify-content-between">
                            <span>Bàn phục vụ</span>
                            <button type="button" class="btn btn-link btn-sm p-0 text-coffee fw-bold text-decoration-none"
                                    data-bs-toggle="modal" data-bs-target="#posFloor3DModal">
                                <i class="bi bi-badge-3d me-1"></i>Chọn 3D
                            </button>
                        </label>
                        <select id="posTableId" class="form-select">
                            <option value="">-- Chọn bàn --</option>
                            @foreach (var t in Model.Tables)
                            {
                                var openInfo = !string.IsNullOrWhiteSpace(t.ActiveOrderCode)
                                    ? $" [Đơn mở: {t.ActiveOrderCode}]"
                                    : $" ({t.StatusText})";
                                <option value="@t.Id"
                                        selected="@(Model.SelectedTableId == t.Id)"
                                        data-open-order-id="@(t.ActiveOrderId?.ToString() ?? "")"
                                        data-open-order-code="@(t.ActiveOrderCode ?? "")">
                                    @t.Code - @t.Zone@openInfo
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Banner thông báo khi chọn bàn đang có đơn mở (gọi thêm món) -->
                <div id="posOpenTableBanner" class="alert alert-warning py-2 px-3 small mb-0" style="display: none;"></div>

                <!-- Tên & SĐT khách (tự động tích điểm nếu khớp khách thành viên) -->
                <div class="row g-2">
                    <div class="col-6">
                        <input type="text" id="posCustomerName" value="@Model.PrefillCustomerName"
                               class="form-control form-control-sm" placeholder="Tên khách (Tùy chọn)" />
                    </div>
                    <div class="col-6">
                        <input type="tel" id="posCustomerPhone" value="@Model.PrefillPhone"
                               class="form-control form-control-sm" placeholder="SĐT tích điểm" />
                    </div>
                </div>

                <!-- Danh sách món đã chọn -->
                <div id="posCartList" class="border rounded-3 px-2 py-1 bg-white"
                     style="min-height: 190px; max-height: 270px; overflow-y: auto;">
                </div>

                <!-- Mã khuyến mãi (Chỉ hiển thị thao tác khi có quyền Staff.ApplyPromotion hoặc Admin) -->
                @if (Model.CanApplyPromotion)
                {
                    <div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-cream"><i class="bi bi-ticket-perforated-fill text-coffee"></i></span>
                            <input type="text" id="posPromoInput" class="form-control text-uppercase" placeholder="Mã giảm giá (VD: WELCOME10)" />
                            <button type="button" id="posApplyPromoBtn" class="btn btn-outline-coffee fw-semibold">Áp mã</button>
                        </div>
                        <div id="posPromoMessage"></div>
                    </div>
                }
                else
                {
                    <div class="small text-muted bg-light rounded-2 px-2 py-1">
                        <i class="bi bi-lock-fill me-1"></i>Tài khoản hiện tại không có quyền áp mã giảm giá tại POS.
                    </div>
                }

                <!-- Tổng kết tiền -->
                <div class="p-2 rounded-3 bg-cream">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Tạm tính:</span>
                        <strong id="posSubtotal">0 ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Giảm giá:</span>
                        <strong class="text-success" id="posDiscount">0 ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-top pt-1">
                        <span class="fw-bold">TỔNG THANH TOÁN:</span>
                        <span class="fs-4 fw-bold text-coffee" id="posTotal">0 ₫</span>
                    </div>
                </div>

                <!-- Phương thức thanh toán + Tính tiền thừa / QR -->
                <div class="row g-2 align-items-center">
                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1">Thanh toán bằng</label>
                        <select id="posPaymentMethod" class="form-select form-select-sm">
                            @if (Model.PaymentMethods.Count > 0)
                            {
                                @foreach (var pm in Model.PaymentMethods)
                                {
                                    <option value="@pm.Code">@pm.Name</option>
                                }
                            }
                            else
                            {
                                <option value="CASH">Tiền mặt</option>
                                <option value="QR">Chuyển khoản / QR</option>
                                <option value="CARD">Thẻ / Ví điện tử</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 pt-3">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" id="posMarkPaid" checked />
                            <label class="form-check-label small fw-semibold" for="posMarkPaid">Đã thu tiền ngay</label>
                        </div>
                    </div>
                </div>

                <!-- Bộ tính tiền thừa nhanh cho thu ngân khi chọn Tiền mặt -->
                <div id="posCashCalcWrap" class="border rounded-3 p-2 bg-light" style="display: @(defaultPaymentCode == "CASH" ? "block" : "none");">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                        <span class="small fw-semibold">Khách đưa:</span>
                        <input type="number" id="posCashGiven" min="0" step="1000"
                               class="form-control form-control-sm text-end w-50" placeholder="Nhập số tiền..." />
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-1">
                        @foreach (var denom in new[] { 50000, 100000, 200000, 500000 })
                        {
                            <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 small pos-quick-cash" data-cash="@denom">
                                @(denom / 1000)k
                            </button>
                        }
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Tiền thối lại:</span>
                        <strong id="posCashChange" class="text-success">0 ₫</strong>
                    </div>
                </div>

                <!-- Hiển thị mã QR chuyển khoản khi chọn QR -->
                <div id="posQrPreviewWrap" class="border rounded-3 p-2 text-center bg-light" style="display: @(defaultPaymentCode == "QR" ? "block" : "none");">
                    @if (Model.StoreSettings.IsQrConfigured)
                    {
                        <img src="@Model.StoreSettings.QrImageUrl" alt="QR Chuyển khoản" class="img-fluid rounded mb-1" style="max-height: 150px;" />
                        <div class="small fw-bold">@Model.StoreSettings.BankName - @Model.StoreSettings.BankAccountNumber</div>
                        <div class="small text-muted">@Model.StoreSettings.BankAccountHolder</div>
                    }
                    else
                    {
                        <div class="small text-muted py-2">
                            <i class="bi bi-qr-code-scan me-1"></i> Admin có thể cấu hình ảnh QR ngân hàng tại Cài đặt cửa hàng.
                        </div>
                    }
                </div>

                <input type="text" id="posOrderNote" class="form-control form-control-sm"
                       placeholder="Ghi chú đơn hàng (VD: Mang ra cùng lúc, ít ngọt...)" />

                <button type="button" id="posSubmitBtn" class="btn btn-accent text-white fw-bold staff-touch-btn w-100 fs-6 mt-1">
                    <i class="bi bi-check2-circle me-1"></i>XÁC NHẬN &amp; IN HÓA ĐƠN
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Tùy chỉnh món POS (Size, Nóng/Lạnh, Đường, Đá, Topping, Ghi chú) -->
<div class="modal fade" id="posItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-coffee text-white">
                <h5 class="modal-title fw-bold" id="posModalTitle">Tùy chỉnh món</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">
                <div>
                    <label class="form-label small fw-bold mb-1">Chọn kích cỡ (Size)</label>
                    <div id="posModalSizes" class="d-flex flex-wrap gap-2"></div>
                </div>

                <div id="posModalTempGroup">
                    <label class="form-label small fw-bold mb-1">Nhiệt độ</label>
                    <div class="d-flex gap-2">
                        <input type="radio" class="btn-check" name="posTemp" id="posTempCold" value="Lạnh" checked />
                        <label class="btn btn-outline-primary staff-touch-btn flex-grow-1" for="posTempCold">
                            <i class="bi bi-snow2 me-1"></i>Lạnh
                        </label>
                        <input type="radio" class="btn-check" name="posTemp" id="posTempHot" value="Nóng" />
                        <label class="btn btn-outline-danger staff-touch-btn flex-grow-1" for="posTempHot">
                            <i class="bi bi-fire me-1"></i>Nóng
                        </label>
                    </div>
                </div>

                <div id="posModalSugarGroup">
                    <label class="form-label small fw-bold mb-1">Mức đường</label>
                    <div class="btn-group w-100" role="group">
                        @foreach (var lv in new[] { "0%", "30%", "50%", "70%", "100%" })
                        {
                            var sid = $"posSugar_{lv.TrimEnd('%')}";
                            <input type="radio" class="btn-check" name="posSugar" id="@sid" value="@lv" checked="@(lv == "100%")" />
                            <label class="btn btn-outline-coffee staff-touch-btn" for="@sid">@lv</label>
                        }
                    </div>
                </div>

                <div id="posModalIceGroup">
                    <label class="form-label small fw-bold mb-1">Mức đá</label>
                    <div class="btn-group w-100" role="group">
                        @foreach (var lv in new[] { "0%", "30%", "50%", "70%", "100%" })
                        {
                            var iid = $"posIce_{lv.TrimEnd('%')}";
                            <input type="radio" class="btn-check" name="posIce" id="@iid" value="@lv" checked="@(lv == "100%")" />
                            <label class="btn btn-outline-coffee staff-touch-btn" for="@iid">@lv</label>
                        }
                    </div>
                </div>

                <div id="posModalToppingSection">
                    <label class="form-label small fw-bold mb-1">Topping thêm</label>
                    <div class="row g-2" id="posModalToppings"></div>
                </div>

                <div class="row g-2 align-items-center">
                    <div class="col-5">
                        <label class="form-label small fw-bold mb-1">Số lượng</label>
                        <div class="input-group">
                            <button type="button" class="btn btn-outline-secondary staff-touch-btn" id="posQtyMinus">-</button>
                            <input type="number" id="posModalQty" value="1" min="1" max="99" class="form-control text-center fw-bold" />
                            <button type="button" class="btn btn-outline-secondary staff-touch-btn" id="posQtyPlus">+</button>
                        </div>
                    </div>
                    <div class="col-7">
                        <label class="form-label small fw-bold mb-1">Ghi chú món</label>
                        <input type="text" id="posModalNote" class="form-control staff-touch-btn" placeholder="VD: Ít sữa, để riêng đá..." />
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div>
                    <span class="small text-muted d-block">Thành tiền món:</span>
                    <strong class="fs-5 text-coffee" id="posModalAddPrice">0 ₫</strong>
                </div>
                <button type="button" id="posModalConfirmBtn" class="btn btn-coffee staff-touch-btn px-4 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i>Thêm vào phiếu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Bộ chọn bàn trực quan trên Sơ đồ 3D ngay trong máy POS -->
<div class="modal fade" id="posFloor3DModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-badge-3d text-warning me-2"></i>Chọn bàn phục vụ trên Sơ đồ 3D
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-2 position-relative">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 px-2">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-coffee" data-pos-zone="ALL">Toàn quán</button>
                        <button type="button" class="btn btn-outline-coffee" data-pos-zone="Tầng 1">Tầng 1</button>
                        <button type="button" class="btn btn-outline-coffee" data-pos-zone="Tầng 2">Tầng 2</button>
                        <button type="button" class="btn btn-outline-coffee" data-pos-zone="Sân vườn">Sân vườn</button>
                    </div>
                    <div class="small text-muted">
                        Chạm bàn màu <strong>Xanh lá</strong> để mở đơn mới, hoặc chạm bàn màu <strong>Cam</strong> để gọi thêm món vào đơn mở.
                    </div>
                </div>
                <div id="posModalFloor3DStage" class="three-floorplan-stage rounded-3 overflow-hidden" style="height: 460px;"></div>
                <div id="posModalFloorTooltip" class="three-tooltip"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos-app.js" asp-append-version="true"></script>
    <script type="module">
        import { initFloorPlan3D } from '/js/three-floorplan.js';

        window.initPosTerminal({
            products: @Html.Raw(Model.ProductsJson),
            canApplyPromo: @(Model.CanApplyPromotion.ToString().ToLowerInvariant()),
            csrfToken: '@csrfToken'
        });

        // Phím mệnh giá tiền mặt nhanh
        document.querySelectorAll('.pos-quick-cash').forEach(btn => {
            btn.addEventListener('click', () => {
                const cashInput = document.getElementById('posCashGiven');
                if (cashInput) {
                    cashInput.value = btn.dataset.cash;
                    cashInput.dispatchEvent(new Event('input'));
                }
            });
        });

        // Khởi tạo Sơ đồ bàn 3D khi mở Modal trong POS
        let posFloorInstance = null;
        const posTablesData = @Html.Raw(Model.TablesJson);
        const modal3DEl = document.getElementById('posFloor3DModal');

        modal3DEl?.addEventListener('shown.bs.modal', () => {
            const tableSelect = document.getElementById('posTableId');
            const selectedId = tableSelect?.value ? parseInt(tableSelect.value, 10) : null;

            if (!posFloorInstance) {
                posFloorInstance = initFloorPlan3D({
                    containerId: 'posModalFloor3DStage',
                    tooltipId: 'posModalFloorTooltip',
                    tables: posTablesData,
                    editable: false,
                    onlySelectAvailable: false,
                    initialSelectedId: selectedId,
                    onSelectTable: (tbl) => {
                        if (tableSelect) {
                            tableSelect.value = String(tbl.id);
                            tableSelect.dispatchEvent(new Event('change'));
                        }
                        bootstrap.Modal.getInstance(modal3DEl)?.hide();
                    }
                });
            } else {
                posFloorInstance.selectTable(selectedId);
                window.dispatchEvent(new Event('resize'));
            }
        });

        document.querySelectorAll('[data-pos-zone]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('[data-pos-zone]').forEach(b => {
                    b.classList.remove('btn-coffee');
                    b.classList.add('btn-outline-coffee');
                });
                btn.classList.remove('btn-outline-coffee');
                btn.classList.add('btn-coffee');
                posFloorInstance?.focusZone(btn.dataset.posZone);
            });
        });
    </script>
}

