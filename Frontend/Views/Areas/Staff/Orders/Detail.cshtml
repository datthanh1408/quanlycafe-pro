@using CoffeeShop.Areas.Staff.Models
@model StaffOrderDetailVm
@{
    var o = Model.Order;
    ViewData["Title"] = $"Chi tiết đơn {o.Code}";
    var currentFlowIndex = Model.StatusFlow.IndexOf(o.Status);

    string GetForwardButtonLabel(OrderStatus next) => next switch
    {
        OrderStatus.Confirmed => "Xác nhận tiếp nhận đơn",
        OrderStatus.Brewing => "Bắt đầu Pha chế (Trừ kho tự động)",
        OrderStatus.Ready => "Báo món Sẵn sàng nhận",
        OrderStatus.Delivering => "Bàn giao Shipper Đang giao",
        OrderStatus.Completed => "Hoàn thành & Đóng đơn hàng",
        _ => $"Chuyển sang {next.GetDisplayName()}"
    };
}

<!-- Thanh điều hướng đầu trang -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a href="/staff/orders" class="btn btn-outline-secondary staff-touch-btn px-3 bg-white">
            <i class="bi bi-arrow-left"></i> Danh sách đơn
        </a>
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="h4 fw-bold mb-0">Đơn hàng @o.Code</h1>
                <span class="order-status-badge" style="background-color: @o.Status.GetBadgeColor();">
                    <i class="bi @o.Status.GetStatusIcon()"></i>
                    @o.Status.GetDisplayName()
                </span>
                <span class="badge bg-dark">@o.Source.GetDisplayName()</span>
            </div>
            <div class="small text-muted">
                Tạo lúc @FormatHelper.DateTimeVn(o.CreatedAt, "dd/MM/yyyy HH:mm:ss")
                • Cập nhật lần cuối @FormatHelper.DateTimeVn(o.UpdatedAt, "HH:mm:ss")
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (o.TableId.HasValue && o.Status != OrderStatus.Completed && o.Status != OrderStatus.Cancelled && o.PaymentStatus != PaymentStatus.Paid)
        {
            <a href="/staff/pos?tableId=@o.TableId" class="btn btn-accent text-white staff-touch-btn px-3 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i> Gọi thêm món (POS Bàn @o.Table?.Code)
            </a>
        }
        <a href="/staff/orders/receipt/@o.Id" class="btn btn-coffee staff-touch-btn px-3 shadow-sm">
            <i class="bi bi-printer-fill"></i> Xem &amp; In hóa đơn
        </a>
    </div>
</div>

<!-- Thanh tiến trình quy trình đơn (Stepper) -->
<div class="stat-card mb-3">
    @if (o.Status == OrderStatus.Cancelled)
    {
        <div class="alert alert-danger mb-0 d-flex align-items-start gap-3">
            <i class="bi bi-x-octagon-fill fs-3 text-danger"></i>
            <div>
                <div class="fw-bold">Đơn hàng đã bị hủy</div>
                <div>Lý do hủy: <strong>@(o.CancelReason ?? "Không ghi nhận")</strong></div>
                <div class="small text-muted mt-1">
                    Người hủy: @(o.CancelledBy ?? "Hệ thống")
                    @if (o.CancelledAt.HasValue)
                    {
                        <span>• Lúc @FormatHelper.DateTimeVn(o.CancelledAt.Value, "dd/MM/yyyy HH:mm")</span>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            @for (int i = 0; i < Model.StatusFlow.Count; i++)
            {
                var step = Model.StatusFlow[i];
                bool isDone = currentFlowIndex > i || o.Status == OrderStatus.Completed;
                bool isCurrent = o.Status == step && o.Status != OrderStatus.Completed;
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 flex-grow-1 @(isCurrent ? "border border-2 shadow-sm bg-cream" : (isDone ? "bg-success-subtle text-success" : "bg-light text-muted"))"
                     style="@(isCurrent ? $"border-color:{step.GetBadgeColor()} !important;" : "")">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                          style="width:32px;height:32px; background-color: @(isCurrent ? step.GetBadgeColor() : (isDone ? "#10B981" : "#9CA3AF"));">
                        @if (isDone)
                        {
                            <i class="bi bi-check-lg"></i>
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </span>
                    <div>
                        <div class="fw-bold small">@step.GetDisplayName()</div>
                        @if (step == OrderStatus.Brewing)
                        {
                            <div style="font-size:0.7rem;" class="text-muted">Trừ kho định lượng</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="row g-3">
    <!-- Cột trái: Chi tiết món, Tổng tiền & Lịch sử trạng thái -->
    <div class="col-12 col-lg-8">
        <div class="stat-card mb-3">
            <h2 class="h5 fw-bold mb-3">
                <i class="bi bi-cup-hot-fill text-coffee me-2"></i>Danh sách món (@o.Items.Sum(x => x.Quantity) ly/phần)
            </h2>

            @if (!string.IsNullOrWhiteSpace(o.Note))
            {
                <div class="alert alert-warning py-2 px-3 small mb-3">
                    <i class="bi bi-sticky-fill me-1"></i><strong>Ghi chú toàn đơn:</strong> @o.Note
                </div>
            }

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Món &amp; Tùy chỉnh pha chế</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in o.Items)
                        {
                            var specs = new List<string>();
                            if (!string.IsNullOrWhiteSpace(item.SizeName)) specs.Add($"Size {item.SizeName}");
                            if (!string.IsNullOrWhiteSpace(item.Temperature)) specs.Add(item.Temperature);
                            if (!string.IsNullOrWhiteSpace(item.SugarLevel)) specs.Add($"Đường {item.SugarLevel}");
                            if (!string.IsNullOrWhiteSpace(item.IceLevel)) specs.Add($"Đá {item.IceLevel}");

                            <tr>
                                <td>
                                    <div class="fw-bold fs-6">@item.ProductName</div>
                                    @if (specs.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @foreach (var sp in specs)
                                            {
                                                <span class="badge bg-cream text-coffee border">@sp</span>
                                            }
                                        </div>
                                    }
                                    @if (item.Toppings.Count > 0)
                                    {
                                        <div class="small text-coffee mt-1">
                                            <i class="bi bi-plus-circle me-1"></i>Topping:
                                            @string.Join(", ", item.Toppings.Select(t => $"{t.ToppingName} (+{FormatHelper.Vnd(t.Price)})"))
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="small fst-italic text-danger mt-1">
                                            <i class="bi bi-chat-dots me-1"></i>Ghi chú ly: "@item.Note"
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-dark fs-6 px-3 py-2">x@(item.Quantity)</span>
                                </td>
                                <td class="text-end text-nowrap">@FormatHelper.Vnd(item.UnitPrice)</td>
                                <td class="text-end fw-bold text-coffee text-nowrap">@FormatHelper.Vnd(item.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end mt-2">
                <div class="col-12 col-md-6">
                    <div class="rounded-3 bg-light p-3 border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-semibold">@FormatHelper.Vnd(o.Subtotal)</span>
                        </div>
                        @if (o.DiscountAmount > 0 || o.Promotion != null)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>
                                    Giảm giá
                                    @if (o.Promotion != null)
                                    {
                                        <span class="badge bg-success ms-1">@o.Promotion.Code</span>
                                    }
                                </span>
                                <span class="fw-semibold">-@FormatHelper.Vnd(o.DiscountAmount)</span>
                            </div>
                        }
                        @if (o.ShippingFee > 0 || o.OrderType == OrderType.Delivery)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Phí giao hàng:</span>
                                <span class="fw-semibold">@FormatHelper.Vnd(o.ShippingFee)</span>
                            </div>
                        }
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Tổng thanh toán:</span>
                            <span class="fw-bold fs-4 text-coffee">@FormatHelper.Vnd(o.Total)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lịch sử chuyển trạng thái -->
        <div class="stat-card">
            <h2 class="h6 fw-bold mb-3">
                <i class="bi bi-journal-check text-coffee me-2"></i>Nhật ký xử lý đơn hàng
            </h2>
            <div class="list-group list-group-flush">
                @foreach (var h in o.StatusHistories.OrderByDescending(x => x.ChangedAt))
                {
                    <div class="list-group-item px-0 py-2 d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-semibold small">
                                @if (h.FromStatus != h.ToStatus)
                                {
                                    <span>@h.FromStatus.GetDisplayName() &rarr; </span>
                                }
                                <span class="badge text-white" style="background-color: @h.ToStatus.GetBadgeColor();">@h.ToStatus.GetDisplayName()</span>
                                <span class="text-muted ms-1">bởi <strong>@h.ChangedBy</strong></span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(h.Note))
                            {
                                <div class="small text-secondary mt-1">@h.Note</div>
                            }
                        </div>
                        <span class="small text-muted text-nowrap">@FormatHelper.DateTimeVn(h.ChangedAt, "dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Cột phải: Các nút thao tác chạm lớn >= 48px, Thanh toán, Hủy đơn & Thông tin khách -->
    <div class="col-12 col-lg-4">
        <!-- Bảng thao tác nghiệp vụ chính -->
        <div class="stat-card mb-3 border-top border-4" style="border-top-color: var(--brand-primary) !important;">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-hand-index-thumb-fill text-coffee me-2"></i>Thao tác xử lý đơn</h2>

            <!-- 1. Khối Thanh toán -->
            <div class="p-3 rounded-3 border mb-3 @(o.PaymentStatus == PaymentStatus.Paid ? "bg-success-subtle border-success-subtle" : "bg-light")">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-uppercase text-muted">Thanh toán (@o.PaymentMethod)</span>
                    @if (o.PaymentStatus == PaymentStatus.Paid)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                    }
                    else if (o.PaymentStatus == PaymentStatus.Refunded)
                    {
                        <span class="badge bg-secondary">Đã hoàn tiền</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                    }
                </div>

                @if (o.PaymentStatus == PaymentStatus.Paid)
                {
                    <div class="small text-success">
                        Xác nhận bởi <strong>@(o.PaymentConfirmedBy ?? "Hệ thống")</strong>
                        @if (o.PaidAt.HasValue)
                        {
                            <span>lúc @FormatHelper.DateTimeVn(o.PaidAt.Value, "HH:mm dd/MM")</span>
                        }
                    </div>
                }

                @if (string.Equals(o.PaymentMethod, "QR", StringComparison.OrdinalIgnoreCase) && Model.StoreSettings.IsQrConfigured)
                {
                    <div class="text-center bg-white rounded-3 p-2 border mt-2">
                        <img src="@Model.StoreSettings.QrImageUrl" alt="QR Chuyển khoản" class="img-fluid rounded" style="max-height: 190px;" />
                        <div class="small fw-bold mt-1">@Model.StoreSettings.BankName – @Model.StoreSettings.BankAccountNumber</div>
                        <div class="small text-muted">@Model.StoreSettings.BankAccountHolder • Nội dung: <strong>@o.Code</strong></div>
                    </div>
                }

                @if (o.PaymentStatus == PaymentStatus.Unpaid && o.Status != OrderStatus.Cancelled)
                {
                    <form method="post" action="/staff/orders/confirm-payment" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@o.Id" />
                        <button type="submit" class="btn btn-success staff-touch-btn w-100 shadow-sm">
                            <i class="bi bi-cash-coin fs-5"></i>
                            <span>Xác nhận đã thu tiền / đã nhận CK</span>
                        </button>
                    </form>
                }
            </div>

            <!-- 2. Khối chuyển bước trạng thái tiếp theo -->
            @if (Model.NextForwardStatus.HasValue)
            {
                var nextStatus = Model.NextForwardStatus.Value;
                bool blockedByUnpaid = nextStatus == OrderStatus.Completed && o.PaymentStatus != PaymentStatus.Paid;

                <div class="mb-3">
                    @if (nextStatus == OrderStatus.Brewing)
                    {
                        <div class="alert alert-info py-2 px-3 small mb-2">
                            <i class="bi bi-box-seam me-1"></i>Chuyển sang <strong>Đang pha chế</strong> sẽ tự động trừ tồn kho nguyên liệu theo công thức món.
                        </div>
                    }

                    @if (blockedByUnpaid)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-2">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Vui lòng bấm <strong>"Xác nhận đã thu tiền / đã nhận CK"</strong> ở trên trước khi Hoàn thành đơn hàng.
                        </div>
                        <button type="button" class="btn btn-secondary staff-touch-btn w-100" disabled>
                            <i class="bi bi-lock-fill"></i>
                            <span>@GetForwardButtonLabel(nextStatus)</span>
                        </button>
                    }
                    else
                    {
                        <form method="post" action="/staff/orders/change-status">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="targetStatus" value="@nextStatus" />
                            <input type="hidden" name="rowVersionBase64" value="@Model.RowVersionBase64" />
                            <button type="submit" class="btn text-white staff-touch-btn w-100 shadow-sm fs-6"
                                    style="background-color: @nextStatus.GetBadgeColor();">
                                <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                                <span>@GetForwardButtonLabel(nextStatus)</span>
                            </button>
                        </form>
                    }
                </div>
            }

            <!-- Nút lùi 1 bước chỉ dành cho Admin (khi cần điều chỉnh nhầm lẫn) -->
            @if (Model.IsAdmin && Model.PrevRollbackStatus.HasValue)
            {
                var prevSt = Model.PrevRollbackStatus.Value;
                <div class="mb-3">
                    <button class="btn btn-sm btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#adminRollbackCollapse">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Admin: Lùi 1 bước về "@prevSt.GetDisplayName()"
                    </button>
                    <div class="collapse mt-2" id="adminRollbackCollapse">
                        <form method="post" action="/staff/orders/change-status" class="border rounded-3 p-2 bg-light">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="targetStatus" value="@prevSt" />
                            <input type="hidden" name="rowVersionBase64" value="@Model.RowVersionBase64" />
                            <input type="text" name="note" class="form-control form-control-sm mb-2" placeholder="Nhập lý do lùi trạng thái (bắt buộc)..." required />
                            <button type="submit" class="btn btn-sm btn-warning w-100 fw-semibold">Xác nhận lùi bước</button>
                        </form>
                    </div>
                </div>
            }

            <!-- 3. Khối Hủy đơn (chỉ hiển thị khi có quyền CanCancelOrder và trạng thái hợp lệ) -->
            @if (Model.CanCancelThisOrder)
            {
                <hr />
                <button type="button" class="btn btn-outline-danger staff-touch-btn w-100" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                    <i class="bi bi-x-octagon-fill"></i>
                    <span>Hủy đơn hàng này</span>
                </button>
            }
        </div>

        <!-- Thông tin Khách hàng & Bàn phục vụ -->
        <div class="stat-card">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-person-lines-fill text-coffee me-2"></i>Thông tin phục vụ</h2>
            <dl class="row mb-0 small gy-2">
                <dt class="col-5 text-muted">Khách hàng:</dt>
                <dd class="col-7 fw-semibold mb-0">@o.CustomerName</dd>

                <dt class="col-5 text-muted">Số điện thoại:</dt>
                <dd class="col-7 mb-0">@(string.IsNullOrWhiteSpace(o.Phone) ? "—" : o.Phone)</dd>

                <dt class="col-5 text-muted">Hình thức:</dt>
                <dd class="col-7 fw-semibold mb-0">@o.OrderType.GetDisplayName()</dd>

                @if (o.Table != null)
                {
                    <dt class="col-5 text-muted">Bàn phục vụ:</dt>
                    <dd class="col-7 mb-0">
                        <a href="/staff/tables?selectedId=@o.TableId" class="badge bg-coffee text-decoration-none">
                            <i class="bi bi-box me-1"></i>Bàn @o.Table.Code (@o.Table.Zone)
                        </a>
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(o.DeliveryAddress))
                {
                    <dt class="col-5 text-muted">Địa chỉ giao:</dt>
                    <dd class="col-7 mb-0">@o.DeliveryAddress</dd>
                }

                <dt class="col-5 text-muted">Nhân viên tạo/xử lý:</dt>
                <dd class="col-7 mb-0">@(o.Staff?.FullName ?? "Khách đặt Online")</dd>
            </dl>
        </div>
    </div>
</div>

<!-- Modal Hủy đơn hàng (Bắt buộc nhập lý do) -->
@if (Model.CanCancelThisOrder)
{
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form method="post" action="/staff/orders/cancel">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@o.Id" />
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fw-bold" id="cancelOrderModalLabel">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i>Xác nhận Hủy đơn @o.Code
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-2">
                            Hủy đơn sẽ giải phóng bàn phục vụ (nếu có) và hoàn lượt mã khuyến mãi. Vui lòng nhập rõ lý do hủy đơn để lưu nhật ký kiểm toán:
                        </p>
                        <div class="mb-2">
                            <label class="form-label fw-semibold" for="cancelReasonInput">Lý do hủy đơn <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="cancelReasonInput" name="reason" rows="3" maxlength="200" required
                                      placeholder="Nhập lý do hủy đơn..."></textarea>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('cancelReasonInput').value='Khách đổi ý hủy đơn'">Khách đổi ý</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('cancelReasonInput').value='Thu ngân tạo nhầm món, tạo lại đơn mới'">Tạo nhầm món</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('cancelReasonInput').value='Không liên hệ xác nhận được với khách'">Không liên hệ được</button>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary staff-touch-btn px-3" data-bs-dismiss="modal">Quay lại</button>
                        <button type="submit" class="btn btn-danger staff-touch-btn px-4">
                            <i class="bi bi-trash3-fill"></i> Xác nhận Hủy đơn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.body.dataset.watchOrderCode = '@o.Code';
        if (window.DatMocRealtime) {
            window.DatMocRealtime.joinOrderGroup('@o.Code');
            window.DatMocRealtime.onStatusChanged((payload) => {
                if (payload && (payload.id === @o.Id || payload.code === '@o.Code')) {
                    if (!document.querySelector('.modal.show')) {
                        location.reload();
                    }
                }
            });
        }
    </script>
}
