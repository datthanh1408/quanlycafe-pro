@model StaffCustomerListVm
@{
    ViewData["Title"] = "Tra cứu khách hàng thành viên";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-coffee me-2"></i>Tra cứu khách hàng &amp; Điểm thành viên
        </h4>
        <div class="small text-muted">
            Tìm nhanh theo SĐT, họ tên hoặc email để kiểm tra điểm tích lũy, lịch sử gọi món và mở đơn POS tích điểm.
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        @if (Model.CanEditCustomer)
        {
            <span class="badge bg-success px-3 py-2">
                <i class="bi bi-pencil-square me-1"></i>Được cấp quyền chỉnh sửa thông tin cơ bản
            </span>
        }
        else
        {
            <span class="badge bg-secondary px-3 py-2">
                <i class="bi bi-eye me-1"></i>Chế độ chỉ tra cứu
            </span>
        }
    </div>
</div>

<!-- Thanh tìm kiếm -->
<div class="card card-coffee mb-3">
    <div class="card-body py-3">
        <form method="get" action="/staff/customers" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-cream"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="@Model.SearchKeyword" class="form-control staff-touch-btn"
                           placeholder="Nhập số điện thoại (VD: 090...), họ tên hoặc email khách hàng..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-coffee staff-touch-btn flex-grow-1">
                    <i class="bi bi-search me-1"></i>Tìm khách
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
                {
                    <a href="/staff/customers" class="btn btn-outline-secondary staff-touch-btn" title="Xóa tìm kiếm">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Danh sách khách hàng -->
<div class="card card-coffee">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Khách hàng</th>
                    <th>Liên hệ &amp; Địa chỉ</th>
                    <th>Điểm tích lũy</th>
                    <th>Tổng đơn / Chi tiêu</th>
                    <th>Đơn gần đây</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-person-exclamation fs-1 d-block mb-2"></i>
                            Không tìm thấy khách hàng thành viên phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Customers.Items)
                    {
                        var posLink = $"/staff/pos?customerName={Uri.EscapeDataString(c.FullName)}&phone={Uri.EscapeDataString(c.Phone ?? "")}";
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">@c.FullName</div>
                                <div class="small text-muted">
                                    Tham gia: @FormatHelper.VnDate(c.CreatedAt)
                                    @if (!c.IsActive)
                                    {
                                        <span class="badge bg-danger ms-1">Đã khóa</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    <i class="bi bi-telephone text-coffee me-1"></i>@(string.IsNullOrWhiteSpace(c.Phone) ? "Chưa cập nhật" : c.Phone)
                                </div>
                                <div class="small text-muted">@c.Email</div>
                                @if (!string.IsNullOrWhiteSpace(c.Address))
                                {
                                    <div class="small text-secondary text-truncate" style="max-width: 240px;" title="@c.Address">
                                        <i class="bi bi-geo-alt me-1"></i>@c.Address
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-warning text-dark px-3 py-2 fs-6">
                                    <i class="bi bi-award-fill me-1"></i>@c.LoyaltyPoints điểm
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-coffee">@FormatHelper.Vnd(c.TotalSpent)</div>
                                <div class="small text-muted">@c.OrderCount đơn hàng</div>
                            </td>
                            <td>
                                @if (c.RecentOrders.Count == 0)
                                {
                                    <span class="small text-muted">Chưa có đơn</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var ro in c.RecentOrders.Take(2))
                                        {
                                            <a href="/staff/orders/detail/@ro.Id" class="small text-decoration-none d-inline-flex align-items-center gap-1">
                                                <span class="fw-semibold text-coffee">@ro.Code</span>
                                                <span class="text-muted">(@FormatHelper.Vnd(ro.Total))</span>
                                            </a>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <a href="@posLink" class="btn btn-sm btn-accent text-white staff-touch-btn" title="Tạo đơn POS tích điểm cho khách này">
                                        <i class="bi bi-calculator me-1"></i>Bán POS
                                    </a>

                                    @if (Model.CanEditCustomer)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-coffee staff-touch-btn btn-edit-customer"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCustomerModal"
                                                data-id="@c.Id"
                                                data-name="@c.FullName"
                                                data-phone="@(c.Phone ?? "")"
                                                data-address="@(c.Address ?? "")">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer bg-white">
        <partial name="~/Frontend/Views/Shared/_Pagination.cshtml"
                 model="(Model.Customers.Page, Model.Customers.TotalPages, Model.BaseQueryUrl)" />
    </div>
</div>

@if (Model.CanEditCustomer)
{
    <!-- Modal chỉnh sửa thông tin cơ bản khách hàng (Chỉ cho phép khi có claim Staff.EditCustomer hoặc Admin) -->
    <div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" action="/staff/customers/edit" class="modal-content border-0 shadow">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editCustId" />
                <input type="hidden" name="ReturnQuery" value="@Model.SearchKeyword" />

                <div class="modal-header bg-coffee text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-gear me-2"></i>Cập nhật thông tin khách hàng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-bold">Họ và tên khách hàng <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" id="editCustName" class="form-control staff-touch-btn" required maxlength="120" />
                    </div>
                    <div>
                        <label class="form-label small fw-bold">Số điện thoại Việt Nam <span class="text-danger">*</span></label>
                        <input type="tel" name="Phone" id="editCustPhone" class="form-control staff-touch-btn" required
                               pattern="^(0|\+84)(3|5|7|8|9)\d{8}$" placeholder="VD: 0912345678" />
                    </div>
                    <div>
                        <label class="form-label small fw-bold">Địa chỉ giao hàng mặc định</label>
                        <textarea name="Address" id="editCustAddress" rows="2" class="form-control" maxlength="300"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary staff-touch-btn" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-coffee staff-touch-btn px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            document.querySelectorAll('.btn-edit-customer').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('editCustId').value = btn.dataset.id || '';
                    document.getElementById('editCustName').value = btn.dataset.name || '';
                    document.getElementById('editCustPhone').value = btn.dataset.phone || '';
                    document.getElementById('editCustAddress').value = btn.dataset.address || '';
                });
            });
        </script>
    }
}

