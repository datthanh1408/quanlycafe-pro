@model StaffProfileVm
@{
    ViewData["Title"] = "Hồ sơ nhân viên & Lịch sử ca trực";
}

<div class="row g-3">
    <!-- Cột trái: Thông tin nhân sự & Phân quyền chi tiết -->
    <div class="col-lg-5">
        <div class="card card-coffee mb-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-coffee text-white d-flex align-items-center justify-content-center fw-bold fs-3 flex-shrink-0"
                         style="width: 68px; height: 68px;">
                        @(string.IsNullOrWhiteSpace(Model.FullName) ? "NV" : Model.FullName.Trim()[0].ToString().ToUpperInvariant())
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">@Model.FullName</h5>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-dark">@role</span>
                            }
                            <span class="badge bg-cream text-coffee border">@Model.Position</span>
                            <span class="badge bg-success">@Model.WorkStatus</span>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3 d-flex flex-column gap-2 small">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Email đăng nhập:</span>
                        <strong>@Model.Email</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Số điện thoại:</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Ngày vào làm:</span>
                        <strong>@FormatHelper.VnDate(Model.HireDate)</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Địa chỉ:</span>
                            <span class="text-end" style="max-width: 240px;">@Model.Address</span>
                        </div>
                    }
                </div>

                <div class="mt-3 pt-3 border-top d-flex gap-2">
                    <a href="/account/change-password" class="btn btn-outline-coffee staff-touch-btn btn-sm flex-grow-1">
                        <i class="bi bi-key-fill me-1"></i>Đổi mật khẩu
                    </a>
                    <a href="/staff/dashboard" class="btn btn-coffee staff-touch-btn btn-sm flex-grow-1">
                        <i class="bi bi-grid-1x2-fill me-1"></i>Về bảng ca trực
                    </a>
                </div>
            </div>
        </div>

        <!-- Ma trận quyền mở rộng (Claims Staff.*) -->
        <div class="card card-coffee">
            <div class="card-header bg-white fw-bold py-3">
                <i class="bi bi-shield-lock-fill text-coffee me-2"></i>Quyền hạn mở rộng được Admin cấp
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var perm in Model.Permissions)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between py-3">
                        <div>
                            <div class="fw-semibold small">@perm.Description</div>
                            <code class="small text-muted">@perm.ClaimValue</code>
                        </div>
                        @if (perm.IsGranted)
                        {
                            <span class="badge bg-success px-3 py-2">
                                <i class="bi bi-check-lg me-1"></i>Đã cấp
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                <i class="bi bi-lock-fill me-1"></i>Không cấp
                            </span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Cột phải: Trạng thái ca hiện tại & Lịch sử 10 ca gần nhất -->
    <div class="col-lg-7">
        @if (Model.ActiveShift != null)
        {
            <div class="alert alert-success border-0 shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <div class="fw-bold">
                        <i class="bi bi-broadcast me-1"></i>Bạn đang có ca trực mở (Ca #@Model.ActiveShift.Id)
                    </div>
                    <div class="small">
                        Mở lúc @FormatHelper.VnDateTime(Model.ActiveShift.OpenedAt) • Tiền đầu ca: <strong>@FormatHelper.Vnd(Model.ActiveShift.OpeningCash)</strong>
                    </div>
                </div>
                <a href="/staff/dashboard" class="btn btn-sm btn-success fw-bold staff-touch-btn">
                    Quản lý &amp; Đóng ca
                </a>
            </div>
        }

        <div class="card card-coffee">
            <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history text-coffee me-2"></i>Lịch sử 10 ca làm việc gần nhất</span>
                <span class="badge bg-cream text-dark border">@Model.RecentShifts.Count ca</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã ca</th>
                            <th>Mở ca / Đóng ca</th>
                            <th class="text-end">Đầu ca</th>
                            <th class="text-end">Kỳ vọng</th>
                            <th class="text-end">Thực đếm</th>
                            <th class="text-end pe-3">Chênh lệch</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentShifts.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Chưa có lịch sử ca làm việc nào được ghi nhận.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var s in Model.RecentShifts)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@s.Id</td>
                                    <td>
                                        <div>Mở: @FormatHelper.VnDateTime(s.OpenedAt)</div>
                                        @if (s.ClosedAt is DateTime closedAtUtc)
                                        {
                                            <div class="text-muted">Đóng: @FormatHelper.VnDateTime(closedAtUtc)</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang mở ca</span>
                                        }
                                    </td>
                                    <td class="text-end">@FormatHelper.Vnd(s.OpeningCash)</td>
                                    <td class="text-end">@FormatHelper.Vnd(s.ExpectedCash)</td>
                                    <td class="text-end">
                                        @(s.CountedCash is decimal counted ? FormatHelper.Vnd(counted) : "---")
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (s.Difference is decimal diff)
                                        {
                                            var diffClass = diff == 0 ? "text-success" : (diff > 0 ? "text-primary" : "text-danger");
                                            <strong class="@diffClass">
                                                @(diff > 0 ? "+" : "")@FormatHelper.Vnd(diff)
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
