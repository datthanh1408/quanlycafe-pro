@model StaffAvailabilityVm
@{
    ViewData["Title"] = "Bật/Tắt trạng thái món còn hàng";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-toggle-on text-coffee me-2"></i>Quản lý trạng thái món trong ca (Còn hàng / Tạm hết)
        </h4>
        <div class="small text-muted">
            Khi quầy bar hết nguyên liệu đột xuất, chạm 1 lần để tạm khóa món trên cả Website khách hàng lẫn máy POS.
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="/staff/availability?filter=all@(Model.CategoryId.HasValue ? $"&categoryId={Model.CategoryId}" : "")"
           class="btn staff-touch-btn btn-sm @(Model.FilterState == "all" ? "btn-dark" : "btn-outline-dark")">
            Tất cả (@(Model.AvailableCount + Model.UnavailableCount))
        </a>
        <a href="/staff/availability?filter=available@(Model.CategoryId.HasValue ? $"&categoryId={Model.CategoryId}" : "")"
           class="btn staff-touch-btn btn-sm @(Model.FilterState == "available" ? "btn-success" : "btn-outline-success")">
            Đang mở bán (@Model.AvailableCount)
        </a>
        <a href="/staff/availability?filter=unavailable@(Model.CategoryId.HasValue ? $"&categoryId={Model.CategoryId}" : "")"
           class="btn staff-touch-btn btn-sm @(Model.FilterState == "unavailable" ? "btn-danger" : "btn-outline-danger")">
            Đang tạm hết (@Model.UnavailableCount)
        </a>
    </div>
</div>

<!-- Thanh lọc theo Danh mục & Từ khóa -->
<div class="card card-coffee mb-3">
    <div class="card-body py-3">
        <form method="get" action="/staff/availability" class="row g-2 align-items-center">
            <input type="hidden" name="filter" value="@Model.FilterState" />
            <div class="col-md-4">
                <select name="categoryId" class="form-select staff-touch-btn" onchange="this.form.submit()">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <input type="text" name="q" value="@Model.SearchKeyword" class="form-control staff-touch-btn"
                       placeholder="Tìm nhanh tên món cần bật/tắt..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-coffee staff-touch-btn flex-grow-1">
                    <i class="bi bi-search me-1"></i>Lọc
                </button>
                <a href="/staff/availability" class="btn btn-outline-secondary staff-touch-btn" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Lưới thẻ chạm bật/tắt nhanh (>= 48px) -->
<div class="row g-3">
    @if (Model.Products.Count == 0)
    {
        <div class="col-12">
            <div class="card card-coffee p-5 text-center text-muted">
                <i class="bi bi-cup-straw fs-1 d-block mb-2"></i>
                Không có món nào khớp điều kiện lọc hiện tại.
            </div>
        </div>
    }
    else
    {
        @foreach (var p in Model.Products)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card card-coffee h-100 @(!p.IsAvailable ? "border-danger border-2" : "")">
                    <div class="card-body p-3 d-flex flex-column justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@p.ImageUrl" alt="@p.Name"
                                 class="rounded-3 object-fit-cover flex-shrink-0 @(!p.IsAvailable ? "opacity-50" : "")"
                                 style="width: 68px; height: 68px;" />
                            <div class="overflow-hidden">
                                <span class="badge bg-cream text-coffee border mb-1">@p.CategoryName</span>
                                <h6 class="fw-bold mb-1 text-truncate" title="@p.Name">@p.Name</h6>
                                <div class="small text-muted">@FormatHelper.Vnd(p.BasePrice) • Đã bán @p.SoldCount</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                            @if (p.IsAvailable)
                            {
                                <span class="badge bg-success px-3 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i>Còn hàng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">
                                    <i class="bi bi-slash-circle-fill me-1"></i>TẠM HẾT
                                </span>
                            }

                            <form method="post" action="/staff/availability/toggle" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.Id" />
                                @if (Model.CategoryId.HasValue)
                                {
                                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
                                {
                                    <input type="hidden" name="q" value="@Model.SearchKeyword" />
                                }
                                <input type="hidden" name="filter" value="@Model.FilterState" />

                                @if (p.IsAvailable)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger staff-touch-btn px-3 fw-semibold">
                                        <i class="bi bi-pause-circle me-1"></i>Báo tạm hết
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-success staff-touch-btn px-3 fw-semibold">
                                        <i class="bi bi-play-circle me-1"></i>Mở bán lại
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

