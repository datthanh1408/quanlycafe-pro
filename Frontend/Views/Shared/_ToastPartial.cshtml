<div id="globalToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
    @if (TempData["ToastSuccess"] is string msgOk && !string.IsNullOrWhiteSpace(msgOk))
    {
        <div class="toast align-items-center text-white bg-success border-0 show mb-2 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle-fill me-2"></i>@msgOk</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest('.toast').remove()" aria-label="Đóng"></button>
            </div>
        </div>
    }
    @if (TempData["ToastError"] is string msgErr && !string.IsNullOrWhiteSpace(msgErr))
    {
        <div class="toast align-items-center text-white bg-danger border-0 show mb-2 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-exclamation-octagon-fill me-2"></i>@msgErr</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest('.toast').remove()" aria-label="Đóng"></button>
            </div>
        </div>
    }
    @if (TempData["ToastWarning"] is string msgWarn && !string.IsNullOrWhiteSpace(msgWarn))
    {
        <div class="toast align-items-center text-dark bg-warning border-0 show mb-2 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-exclamation-triangle-fill me-2"></i>@msgWarn</div>
                <button type="button" class="btn-close me-2 m-auto" onclick="this.closest('.toast').remove()" aria-label="Đóng"></button>
            </div>
        </div>
    }
</div>
<script>
    setTimeout(() => {
        document.querySelectorAll('#globalToastContainer .toast').forEach(t => t.remove());
    }, 5500);
</script>

