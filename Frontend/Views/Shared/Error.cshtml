@{
    ViewData["Title"] = "Đã xảy ra sự cố";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card card-coffee p-5 shadow-sm">
        <div class="mb-3 text-danger">
            <i class="bi bi-exclamation-octagon-fill" style="font-size: 3.5rem;"></i>
        </div>
        <h3 class="fw-bold text-coffee mb-2">Hệ thống tạm thời gặp sự cố</h3>
        <p class="text-muted mb-4">
            Yêu cầu của bạn chưa thể hoàn tất ngay lúc này. Vui lòng thử lại sau ít phút hoặc quay về trang chủ.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a href="/" class="btn btn-coffee px-4">
                <i class="bi bi-house-door-fill me-1"></i>Về trang chủ
            </a>
            <a href="/menu" class="btn btn-outline-coffee px-4">
                <i class="bi bi-cup-hot me-1"></i>Xem thực đơn
            </a>
        </div>
    </div>
</div>
