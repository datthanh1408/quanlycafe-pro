@model ProfileUpdateViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var user = ViewBag.UserEntity as ApplicationUser ?? new ApplicationUser();
    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
    decimal totalSpent = ViewBag.TotalSpent ?? 0m;
    var store = ViewBag.Store as StoreSettingsDto ?? new StoreSettingsDto();
}

<div class="container py-4 py-lg-5">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                    {
                        <img src="@user.AvatarUrl" alt="@user.FullName" class="rounded-circle object-fit-cover border" style="width: 68px; height: 68px;" />
                    }
                    else
                    {
                        <span class="rounded-circle bg-coffee text-white d-inline-flex align-items-center justify-content-center fs-3 fw-bold" style="width: 68px; height: 68px;">
                            @(string.IsNullOrWhiteSpace(user.FullName) ? "K" : user.FullName[0].ToString().ToUpper())
                        </span>
                    }
                    <div>
                        <h1 class="h5 fw-bold mb-0">@user.FullName</h1>
                        <small class="text-muted">@user.Email</small>
                    </div>
                </div>

                <div class="row g-2 text-center mb-3">
                    <div class="col-6">
                        <div class="p-3 rounded-3 bg-cream">
                            <span class="small text-muted d-block">Điểm tích lũy</span>
                            <strong class="fs-5 text-coffee"><i class="bi bi-gem me-1"></i>@user.LoyaltyPoints điểm</strong>
                            <small class="d-block text-muted" style="font-size:0.7rem;">1 điểm = @FormatHelper.Vnd(store.LoyaltyRedeemValueVnd)</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 bg-cream">
                            <span class="small text-muted d-block">Tổng chi tiêu</span>
                            <strong class="fs-6 text-coffee">@FormatHelper.Vnd(totalSpent)</strong>
                            <small class="d-block text-muted" style="font-size:0.7rem;">Đơn hoàn thành</small>
                        </div>
                    </div>
                </div>

                <form method="post" action="/account" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên *</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại *</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ mặc định</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="AvatarFile" class="form-label small fw-semibold">Ảnh đại diện (JPG/PNG/WEBP ≤ 2 MB)</label>
                        <input asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-coffee w-100 mb-2">Lưu thông tin hồ sơ</button>
                    <a href="/account/change-password" class="btn btn-outline-secondary w-100 btn-sm">Đổi mật khẩu</a>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">Lịch sử đơn hàng gần đây</h2>
                    <a href="/orders" class="btn btn-sm btn-outline-coffee">Xem tất cả</a>
                </div>

                @if (recentOrders.Count == 0)
                {
                    <p class="text-muted small mb-0">Bạn chưa có đơn hàng nào.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày đặt</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in recentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold text-coffee">@o.Code</td>
                                        <td>@FormatHelper.DateTimeVn(o.CreatedAt)</td>
                                        <td class="fw-semibold">@FormatHelper.Vnd(o.Total)</td>
                                        <td><partial name="_StatusBadge" model="o.Status" /></td>
                                        <td class="text-end"><a href="/orders/@o.Code" class="btn btn-sm btn-light border">Xem</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

